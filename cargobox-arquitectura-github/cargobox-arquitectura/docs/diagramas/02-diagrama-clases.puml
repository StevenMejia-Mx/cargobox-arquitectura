@startuml 02-diagrama-clases
title CargoBox - Diagrama de Clases DDD (Domain Model + Service Layer con CQRS básico)
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction
skinparam class {
  BackgroundColor<<AggregateRoot>> #FFE699
  BackgroundColor<<Entity>> #DCEBFF
  BackgroundColor<<ValueObject>> #E2F0D9
  BackgroundColor<<DomainEvent>> #F4CCCC
  BackgroundColor<<DomainService>> #FCE4D6
  BackgroundColor<<DomainError>> #FBE5E5
  BackgroundColor<<ApplicationService>> #D9D2E9
  BackgroundColor<<QueryService>> #BDD7EE
  BackgroundColor<<Command>> #E4DFEC
  BackgroundColor<<Query>> #DDEBF7
  BackgroundColor<<DTO>> #FFFFFF
  BackgroundColor<<Repository>> #EDEDED
  BorderColor #555555
}

package "application.comandos (escritura)" #F7F5FB {
  class EnvioApplicationService <<ApplicationService>> {
    + registrarGuia(cmd: RegistrarGuiaCommand): GuiaRegistradaDTO
  }
  class RastreoApplicationService <<ApplicationService>> {
    + registrarEscaneo(cmd: RegistrarEscaneoCommand): EscaneoRegistradoDTO
  }
  class EntregaApplicationService <<ApplicationService>> {
    + registrarIntentoFallido(cmd: RegistrarIntentoFallidoCommand): IntentoEntregaDTO
    + capturarEvidenciaEntrega(cmd: CapturarEvidenciaEntregaCommand): EntregaRegistradaDTO
  }
  class RegistrarGuiaCommand <<Command>> {
    remitente; destinatario; peso; dimensiones
    nivelServicio; valorDeclarado; sucursalId
  }
  class RegistrarEscaneoCommand <<Command>> {
    numeroGuia; tipoEscaneo; centroId; registradoPor
  }
  class RegistrarIntentoFallidoCommand <<Command>> {
    numeroGuia; repartidorId; motivo; ubicacion
  }
  class CapturarEvidenciaEntregaCommand <<Command>> {
    numeroGuia; repartidorId; firmaDigital; foto
    nombreReceptor; ubicacion
  }
  class GuiaRegistradaDTO <<DTO>> {
    numeroGuia; tarifa; fechaEstimada
  }
  class EscaneoRegistradoDTO <<DTO>> {
    numeroGuia; nuevoEstado; ubicacion; fechaHora
  }
  class IntentoEntregaDTO <<DTO>> {
    numeroIntento; estadoGuia
  }
  class EntregaRegistradaDTO <<DTO>> {
    numeroGuia; estado; fechaHora
  }
  class GuiaNoEncontrada <<ApplicationError>>
}

package "application.consultas (lectura)" #EEF5FC {
  class ConsultaRastreoQueryService <<QueryService>> {
    + consultarHistorial(q: ConsultarHistorialQuery): HistorialEnvioView
  }
  class ConsultarHistorialQuery <<Query>> {
    numeroGuia; remitenteId
  }
  class HistorialEnvioView <<DTO>> {
    estadoActual; fechaEstimada
    lineaDeTiempo: List<EventoView>
  }
  interface HistorialRastreoReader <<Repository>> {
    + porNumero(n: NumeroGuia, remitenteId): HistorialEnvioView
  }
  interface HistorialRastreoWriter <<Repository>> {
    + agregarEvento(e: DomainEvent): void
  }
  class HistorialRastreoProjection {
    + on(e: DomainEvent): void
  }
  class NotificacionHandler {
    + on(e: DomainEvent): void
  }
}

package "domain.guia" #FFFDF3 {
  class Guia <<AggregateRoot>> {
    - numero: NumeroGuia
    - remitente: Persona
    - destinatario: Persona
    - peso: Peso
    - dimensiones: Dimensiones
    - nivelServicio: NivelServicio
    - tarifa: Dinero
    - valorDeclarado: Dinero
    - estado: EstadoGuia
    - sucursalOrigenId: SucursalId
    - eventos: List<EventoRastreo>
    - intentos: List<IntentoEntrega>
    + {static} generar(numero, remitente, destinatario, peso, dimensiones, nivel, tarifa, valorDeclarado, sucursalId): Guia
    + registrarEscaneo(tipo, centro: CentroDistribucion, registradoPor): void
    + registrarIntentoFallido(motivo, repartidorId, ubicacion): void
    + registrarEntrega(evidencia: EvidenciaEntrega, repartidorId, ubicacion): void
    + fechaEstimada(): Date
    - cambiarEstado(nuevo, ubicacion, responsable): void
    + eventosPendientes(): List<DomainEvent>
  }
  class EventoRastreo <<Entity>> {
    - estado: EstadoGuia
    - fechaHora: DateTime
    - ubicacion: Ubicacion
    - responsable: String
  }
  class IntentoEntrega <<Entity>> {
    - numero: int
    - fechaHora: DateTime
    - exitoso: boolean
    - motivo: MotivoNoEntrega
    - repartidorId: RepartidorId
    - evidencia: EvidenciaEntrega
  }
  class NumeroGuia <<ValueObject>> {
    - valor: String
  }
  class Persona <<ValueObject>> {
    - nombre: String
    - telefono: String
    - direccion: Direccion
  }
  class Direccion <<ValueObject>> {
    - calle: String
    - ciudad: String
    - codigoPostal: String
  }
  class Peso <<ValueObject>> {
    - kg: decimal
    + excedeLimite(): boolean
  }
  class Dimensiones <<ValueObject>> {
    - largoCm: decimal
    - anchoCm: decimal
    - altoCm: decimal
    + excedeLimite(): boolean
  }
  class Dinero <<ValueObject>> {
    - monto: decimal
    - moneda: String
  }
  class EvidenciaEntrega <<ValueObject>> {
    - nombreReceptor: String
    - firmaUrl: String
    - fotoUrl: String
    + {static} crear(nombre, firmaUrl, fotoUrl): EvidenciaEntrega
  }
  class Ubicacion <<ValueObject>> {
    - instalacionId: String
    - ciudad: String
  }
  enum NivelServicio <<ValueObject>> {
    ESTANDAR
    EXPRESS
  }
  enum EstadoGuia <<ValueObject>> {
    RECIBIDO
    CLASIFICADO
    EN_TRANSITO
    CENTRO_DESTINO
    EN_REPARTO
    ENTREGADO
    EN_RESGUARDO
  }
  enum TipoEscaneo <<ValueObject>> {
    INGRESO
    SALIDA
  }
  enum MotivoNoEntrega <<ValueObject>> {
    DESTINATARIO_AUSENTE
    DIRECCION_INCORRECTA
  }
  class Cotizador <<DomainService>> {
    + cotizar(peso, dimensiones, destino, nivel): Dinero
  }
  interface PoliticaTarifa {
    + aplicaA(nivel: NivelServicio): boolean
    + calcular(peso, dimensiones, destino): Dinero
  }
  class TarifaEstandar
  class TarifaExpress
  interface GuiaRepository <<Repository>> {
    + porNumero(n: NumeroGuia): Guia
    + siguienteNumero(): NumeroGuia
    + guardar(g: Guia): void
  }
}

package "domain.errores" #FFF7F7 {
  class CargaEspecialRequerida <<DomainError>>
  class TransicionEstadoInvalida <<DomainError>>
  class LimiteIntentosExcedido <<DomainError>>
  class EvidenciaIncompleta <<DomainError>>
  class EntregaYaRegistrada <<DomainError>>
}

package "domain.red" #FFFDF3 {
  class Sucursal <<AggregateRoot>> {
    - id: SucursalId
    - nombre: String
  }
  class CentroDistribucion <<AggregateRoot>> {
    - id: CentroId
    - codigosPostales: Set<String>
    + atiende(cp: String): boolean
  }
  class Repartidor <<AggregateRoot>> {
    - id: RepartidorId
    - nombre: String
  }
  interface SucursalRepository <<Repository>> {
    + porId(id: SucursalId): Sucursal
  }
  interface CentroDistribucionRepository <<Repository>> {
    + porId(id: CentroId): CentroDistribucion
  }
}

package "domain.eventos" #FFF5F5 {
  abstract class DomainEvent <<DomainEvent>> {
    - numeroGuia: NumeroGuia
    - ocurridoEn: DateTime
  }
  class GuiaGenerada <<DomainEvent>>
  class EscaneoRegistrado <<DomainEvent>>
  class IntentoEntregaFallido <<DomainEvent>>
  class GuiaEnResguardo <<DomainEvent>>
  class EntregaCompletada <<DomainEvent>>
}

package "infrastructure" #F2F2F2 {
  interface UnitOfWork {
    + iniciar(): void
    + confirmar(): void
    + deshacer(): void
  }
  interface PublicadorEventos {
    + publicar(eventos: List<DomainEvent>): void
  }
  interface AlmacenEvidencias {
    + guardar(firma, foto): Urls
  }
  interface Notificador {
    + notificar(persona: Persona, mensaje: String): void
  }
  class MySqlGuiaRepository
  class MySqlHistorialRastreo
}

' composición del agregado
Guia *-- NumeroGuia
Guia *-- "2" Persona
Persona *-- Direccion
Guia *-- Peso
Guia *-- Dimensiones
Guia *-- NivelServicio
Guia *-- "2" Dinero
Guia *-- EstadoGuia
Guia "1" *-- "1..*" EventoRastreo
Guia "1" *-- "0..2" IntentoEntrega
IntentoEntrega *-- "0..1" EvidenciaEntrega
IntentoEntrega *-- MotivoNoEntrega
EventoRastreo *-- Ubicacion
Guia ..> TipoEscaneo

' errores de dominio
Guia ..> CargaEspecialRequerida : RN-01
Guia ..> TransicionEstadoInvalida : RN-04
Guia ..> LimiteIntentosExcedido : RN-06
Guia ..> EntregaYaRegistrada : RN-07
EvidenciaEntrega ..> EvidenciaIncompleta : RN-07

' eventos
DomainEvent <|-- GuiaGenerada
DomainEvent <|-- EscaneoRegistrado
DomainEvent <|-- IntentoEntregaFallido
DomainEvent <|-- GuiaEnResguardo
DomainEvent <|-- EntregaCompletada
Guia ..> DomainEvent : registra

' referencias por ID
Guia ..> Sucursal : sucursalOrigenId
Guia ..> CentroDistribucion : escaneo US04
IntentoEntrega ..> Repartidor : repartidorId

' tarifa
Cotizador --> "1..*" PoliticaTarifa : OCP
TarifaEstandar ..|> PoliticaTarifa
TarifaExpress ..|> PoliticaTarifa

' application services (comandos)
EnvioApplicationService ..> RegistrarGuiaCommand
EnvioApplicationService ..> GuiaRegistradaDTO
EnvioApplicationService --> GuiaRepository
EnvioApplicationService --> SucursalRepository
EnvioApplicationService --> Cotizador
EnvioApplicationService --> UnitOfWork
EnvioApplicationService --> PublicadorEventos
RastreoApplicationService ..> RegistrarEscaneoCommand
RastreoApplicationService ..> EscaneoRegistradoDTO
RastreoApplicationService --> GuiaRepository
RastreoApplicationService --> CentroDistribucionRepository
RastreoApplicationService --> UnitOfWork
RastreoApplicationService --> PublicadorEventos
EntregaApplicationService ..> RegistrarIntentoFallidoCommand
EntregaApplicationService ..> CapturarEvidenciaEntregaCommand
EntregaApplicationService ..> IntentoEntregaDTO
EntregaApplicationService ..> EntregaRegistradaDTO
EntregaApplicationService --> GuiaRepository
EntregaApplicationService --> AlmacenEvidencias
EntregaApplicationService --> UnitOfWork
EntregaApplicationService --> PublicadorEventos
EnvioApplicationService ..> GuiaNoEncontrada
RastreoApplicationService ..> GuiaNoEncontrada
EntregaApplicationService ..> GuiaNoEncontrada

' consulta (CQRS)
ConsultaRastreoQueryService ..> ConsultarHistorialQuery
ConsultaRastreoQueryService ..> HistorialEnvioView
ConsultaRastreoQueryService --> HistorialRastreoReader
PublicadorEventos ..> HistorialRastreoProjection : despacha
PublicadorEventos ..> NotificacionHandler : despacha
HistorialRastreoProjection --> HistorialRastreoWriter
NotificacionHandler --> Notificador

' implementaciones
MySqlGuiaRepository ..|> GuiaRepository
MySqlHistorialRastreo ..|> HistorialRastreoReader
MySqlHistorialRastreo ..|> HistorialRastreoWriter
@enduml

@startuml 01-mapa-dominio
title CargoBox - Mapa de Dominio
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #FFE699
  BackgroundColor<<Entity>> #DCEBFF
  BackgroundColor<<ValueObject>> #E2F0D9
  BackgroundColor<<DomainEvent>> #F4CCCC
  BackgroundColor<<DomainService>> #FCE4D6
  BorderColor #555555
}
hide empty members
hide circle

package "Agregado GUÍA (RN-02, RN-04, RN-05, RN-06, RN-07)" #FFFDF3 {
  class Guia <<AggregateRoot>>
  class EventoRastreo <<Entity>>
  class IntentoEntrega <<Entity>>
  class NumeroGuia <<ValueObject>>
  class Persona <<ValueObject>>
  class Direccion <<ValueObject>>
  class Peso <<ValueObject>>
  class Dimensiones <<ValueObject>>
  class NivelServicio <<ValueObject>>
  class Dinero <<ValueObject>>
  class EstadoGuia <<ValueObject>>
  class Ubicacion <<ValueObject>>
  class EvidenciaEntrega <<ValueObject>>
}
package "Agregado SUCURSAL" #FFFDF3 {
  class Sucursal <<AggregateRoot>>
}
package "Agregado CENTRO DE DISTRIBUCIÓN" #FFFDF3 {
  class CentroDistribucion <<AggregateRoot>>
}
package "Agregado REPARTIDOR" #FFFDF3 {
  class Repartidor <<AggregateRoot>>
}
class Cotizador <<DomainService>>
package "Domain Events" #FFF5F5 {
  class GuiaGenerada <<DomainEvent>>
  class EscaneoRegistrado <<DomainEvent>>
  class IntentoEntregaFallido <<DomainEvent>>
  class GuiaEnResguardo <<DomainEvent>>
  class EntregaCompletada <<DomainEvent>>
}

Guia *-- NumeroGuia
Guia *-- "2" Persona : remitente / destinatario
Persona *-- Direccion
Guia *-- Peso : RN-01
Guia *-- Dimensiones : RN-01
Guia *-- NivelServicio
Guia *-- "2" Dinero : tarifa / valor declarado
Guia *-- EstadoGuia : RN-04
Guia *-- "1..*" EventoRastreo : RN-05
Guia *-- "0..2" IntentoEntrega : RN-06
IntentoEntrega *-- "0..1" EvidenciaEntrega : RN-07
EventoRastreo *-- Ubicacion

Guia ..> Sucursal : sucursalOrigenId
Guia ..> CentroDistribucion : escaneo US04
IntentoEntrega ..> Repartidor : repartidorId
Cotizador ..> Guia : tarifa (RN-03)

Guia ..> GuiaGenerada : US01
Guia ..> EscaneoRegistrado : US04
Guia ..> IntentoEntregaFallido : US05
Guia ..> GuiaEnResguardo : US05
Guia ..> EntregaCompletada : US06

legend right
  <back:#FFE699> Aggregate Root </back>
  <back:#DCEBFF> Entidad </back>
  <back:#E2F0D9> Value Object </back>
  <back:#FCE4D6> Domain Service </back>
  <back:#F4CCCC> Domain Event </back>
  línea continua = composición dentro del agregado
  línea punteada = referencia por ID / emite evento
  RN-xx = regla de negocio que protege
endlegend
@enduml
